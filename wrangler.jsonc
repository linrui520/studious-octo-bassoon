# 在仓库目录下执行
cat > wrangler.jsonc << 'EOF'
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inrui0604",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
EOF

# 提交到 GitHub
git add wrangler.jsonc
git commit -m "添加 wrangler 配置"
git push
